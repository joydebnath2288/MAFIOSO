# Normalize line endings across Windows/Linux/macOS for Docker compatibility
* text=auto eol=lf

*.sh text eol=lf
*.sql text eol=lf
*.conf text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.java text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf
