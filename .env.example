# =============================================================================
# MAFIOSO Study Abroad Consultancy Platform - Environment Configuration Template
# =============================================================================
# Copy this file to `.env` before running Docker Compose:
#   cp .env.example .env
# Never commit `.env` with real credentials to version control.

# Application Runtime
APP_ENV=development
APP_HTTP_PORT=80

# MySQL 8 Configuration (internal Docker Compose network only)
DB_HOST=db
DB_PORT=3306
DB_NAME=mafioso_db
DB_USER=mafioso_user
DB_PASSWORD=change_me_strong_db_password
DB_ROOT_PASSWORD=change_me_strong_root_password
DB_USE_SSL=false

# Private Student Document Storage (mounted volume inside backend container)
STORAGE_UPLOAD_DIR=/var/mafioso/storage/documents

# Session & Authentication Security (non-secret defaults)
SESSION_TIMEOUT_MINUTES=30
# Leave blank for automatic (Secure=true when APP_ENV=production, false in local HTTP dev)
SESSION_COOKIE_SECURE=
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_IP_MAX_ATTEMPTS=25
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_LOCKOUT_SECONDS=300

# One-time Initial Admin Bootstrap (keep disabled; prefer interactive CLI inside container)
# If temporarily enabled for initial setup, remove credentials and set false immediately after.
MAFIOSO_BOOTSTRAP_ADMIN_ENABLED=false

# Frontend Build/Runtime Public Variables (NEVER put backend secrets here)
VITE_APP_NAME=MAFIOSO
VITE_API_BASE_URL=
